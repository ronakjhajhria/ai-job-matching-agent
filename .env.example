JOBMIND_SERVICE_NAME=JobMind
JOBMIND_ENVIRONMENT=development
JOBMIND_LOG_LEVEL=DEBUG

# --- LLM ---
# Required for /api/v1/skills/extract, /api/v1/intelligence/*, /api/v1/matching/*, /api/v1/rag/ask, /api/v1/agent/ask
JOBMIND_OPENAI_API_KEY=sk-...
JOBMIND_OPENAI_MODEL=gpt-4o-mini
JOBMIND_LLM_TIMEOUT_SECONDS=30
JOBMIND_LLM_MAX_RETRIES=2

# --- Embeddings ---
JOBMIND_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
JOBMIND_EMBEDDING_VECTOR_SIZE=1536

# --- RAG Chunking ---
JOBMIND_CHUNK_SIZE=1000
JOBMIND_CHUNK_OVERLAP=200

# --- Qdrant ---
# Leave as ":memory:" for local dev, set to http://qdrant:6333 when using Docker
JOBMIND_QDRANT_URL=:memory:
JOBMIND_QDRANT_COLLECTION=jobmind_docs

# --- PostgreSQL (local host URL; Docker Compose overrides the hostname) ---
JOBMIND_POSTGRES_DB=jobmind
JOBMIND_POSTGRES_USER=jobmind
# Development-only password. Use a secret manager or deployment secret in production.
JOBMIND_POSTGRES_PASSWORD=jobmind
JOBMIND_DATABASE_URL=postgresql+psycopg://jobmind:jobmind@localhost:5432/jobmind

# --- Redis ---
JOBMIND_REDIS_URL=redis://localhost:6379/0
JOBMIND_SESSION_TTL_SECONDS=86400
JOBMIND_SESSION_MAX_MESSAGES=30
